# run/ is the scratch directory for an actual bench session -- drives, captures
# and loop state for one run. The committed waveforms live in waveforms/.
run/

# ... and the same artefacts wherever else they land
*.state.npz
meas_*.npy
drive_*_iter*.csv
!waveforms/*.csv

# Superseded bench outputs kept for the record, not for the repository
archive/

# The raw scope captures live outside the repo (~260 MB); see EOM_RAMPS_DIR
cache/
*.npy

__pycache__/
*.pyc
.DS_Store
