# run/ is the ACTIVE campaign workspace -- states, drives, measurements and
# FRFs for whatever is currently being iterated. The committed waveforms live
# in waveforms/; finished campaigns get filed under archive/. Only the README
# describing the workspace is tracked.
run/*
!run/README.md

# ... and the same artefacts wherever else they land
*.state.npz
meas_*.npy
drive_*_iter*.csv
!waveforms/*.csv

# Superseded bench outputs kept for the record, not for the repository
archive/

# The raw scope captures live outside the repo (~260 MB); see EOM_RAMPS_DIR
cache/
*.npy

__pycache__/
*.pyc
.DS_Store
